{
  "name": "theme.changer",
  "version": "1.0.0",
  "description": "GPU-accelerated organic theme transitions using WebGL2 shaders, noise textures, and smart viewport capture.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "build:lib": "vite build --mode lib",
    "build": "vite build && vite build --mode lib",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "gsap": "^3.15.1",
    "html2canvas": "^1.4.1"
  }
}
